<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>xyz.lalaggi.velox</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Velox</name>
  <summary>Download videos with yt-dlp</summary>
  <description>
    <p>
      A fast, clean frontend for yt-dlp built with GTK4 and libadwaita.
    </p>
  </description>
  <url type="homepage">https://gitlab.com/Lalaggi/Velox</url>
  <launchable type="desktop-id">xyz.lalaggi.velox.desktop</launchable>
  <!-- Transitional: replace old com.github ID -->
  <provides>
    <id>com.github.lalaggi.velox.desktop</id>
  </provides>
  <replaces>
    <id>com.github.lalaggi.velox</id>
  </replaces>
  <translation type="gettext">velox</translation>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <releases>
    <release version="0.1.0" date="2026-07-11">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
</component>

<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.lalaggi.velox</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Velox</name>
  <summary>Download videos with yt-dlp</summary>
  <description>
    <p>
      A fast, clean frontend for yt-dlp built with GTK4 and libadwaita.
    </p>
  </description>
  <url type="homepage">https://github.com/Lalaggi/Velox</url>
  <launchable type="desktop-id">com.github.lalaggi.velox.desktop</launchable>
  <translation type="gettext">velox</translation>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <releases>
    <release version="0.1.0" date="2026-07-11">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
</component>

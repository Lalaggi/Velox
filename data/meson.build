install_data(
    'com.github.lalaggi.velox.svg',
    install_dir: join_paths(get_option('datadir'), 'icons', 'hicolor', 'scalable', 'apps'),
    rename: 'com.github.lalaggi.velox.svg',
)

install_data(
    'com.github.lalaggi.velox.desktop.in',
    install_dir: join_paths(get_option('datadir'), 'applications'),
    rename: 'com.github.lalaggi.velox.desktop',
)

install_data(
    'com.github.lalaggi.velox.metainfo.xml.in',
    install_dir: join_paths(get_option('datadir'), 'metainfo'),
    rename: 'com.github.lalaggi.velox.metainfo.xml',
)

install_data(
    'com.github.lalaggi.velox.gschema.xml',
    install_dir: join_paths(get_option('datadir'), 'glib-2.0', 'schemas'),
)

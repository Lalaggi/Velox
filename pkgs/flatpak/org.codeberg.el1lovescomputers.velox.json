{
    "app-id": "org.codeberg.el1lovescomputers.velox",
    "runtime": "org.gnome.Platform",
    "runtime-version": "48",
    "sdk": "org.gnome.Sdk",
    "command": "velox",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--filesystem=home",
        "--talk-name=org.gtk.vfs.*",
        "--env=PATH=/app/bin:/app/extensions/bin:/usr/bin",
        "--env=PYTHONPATH=/app/lib/python3.12/site-packages"
    ],
    "build-options": {
        "env": {
            "PIP_DISABLE_PIP_VERSION_CHECK": "1"
        }
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/share/vala",
        "*.la",
        "*.a",
        "/lib/python3.12/test/*",
        "/lib/python3.12/idlelib/*",
        "/lib/python3.12/__pycache__/*",
        "/lib/python3.12/distutils/__pycache__/*",
        "/lib/python3.12/ensurepip/__pycache__/*"
    ],
    "modules": [
        {
            "name": "ffmpeg",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-doc",
                "--disable-ffplay",
                "--disable-static",
                "--enable-shared"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ffmpeg.org/releases/ffmpeg-7.1.1.tar.xz",
                    "sha256": "733984395e0dbbe5c046abda2dc49a5544e7e0e1e2366bba849222ae9e3a03b1"
                }
            ]
        },
        {
            "name": "python3",
            "buildsystem": "autotools",
            "config-opts": [
                "--with-ensurepip=install",
                "--with-system-ffi",
                "--with-ssl-default-suites=openssl",
                "--with-openssl-rpath=auto"
            ],
            "no-autogen": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.python.org/ftp/python/3.12.4/Python-3.12.4.tar.xz",
                    "sha256": "f6d419a6d8743ab26700801b4908d26d97e8b986e14f95de31b32de2b0e79554"
                }
            ]
        },
        {
            "name": "python3-yt-dlp",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --break-system-packages --no-build-isolation --no-index --find-links . yt-dlp"
            ],

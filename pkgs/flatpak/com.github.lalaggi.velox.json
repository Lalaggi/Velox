{
    "app-id": "com.github.lalaggi.velox",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "appstream-compose": false,
    "command": "velox",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--filesystem=home",
        "--talk-name=org.gtk.vfs.*",
        "--env=PATH=/app/bin:/app/extensions/bin:/usr/bin",
        "--env=PYTHONPATH=/app/lib/python3.13/site-packages"
    ],
    "build-options": {
        "env": {
            "PIP_DISABLE_PIP_VERSION_CHECK": "1"
        }
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/share/vala",
        "*.la",
        "*.a",
        "/lib/python3.13/test/*",
        "/lib/python3.13/idlelib/*",
        "/lib/python3.13/__pycache__/*",
        "*.pyc"
    ],
    "add-extensions": {
        "org.freedesktop.Platform.Extension.ffmpeg-full": {
            "directory": "lib/ffmpeg",
            "version": "24.08",
            "add-ld-path": "."
        }
    },
    "modules": [
        "python3-yt-dlp.json",
        {
            "name": "velox",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../../"
                }
            ]
        }
    ]
}
